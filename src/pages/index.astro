---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AboutRecruiter from '../components/AboutRecruiter.astro';
import SkillsMatrix from '../components/SkillsMatrix.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title),
);
---
<Layout>
  <Header />
  <main>
    <Hero />
    <AboutRecruiter />
    <SkillsMatrix />
    <section id="projects" class="section">
      <p class="h2">// ls projects/</p>
      <h2 class="h2-title">Proyectos</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {projects.map((p) => (
          <ProjectCard {...p.data} />
        ))}
      </div>
    </section>
    <ExperienceTimeline />
    <ContactSection />
  </main>
  <Footer />
</Layout>
