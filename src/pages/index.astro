---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectItem from '../components/ProjectItem.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Skills from '../components/Skills.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title),
);
---
<Layout>
  <Header />
  <main>
    <Hero />
    <Section id="projects" title="Proyectos">
      <ul class="divide-y divide-line">
        {projects.map((p) => <ProjectItem {...p.data} />)}
      </ul>
    </Section>
    <ExperienceTimeline />
    <Skills />
    <ContactSection />
  </main>
  <Footer />
</Layout>
