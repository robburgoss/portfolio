---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Roberto Burgos Vidal | Técnico de Sistemas & Backend Jr', description = 'Portfolio de Roberto Burgos Vidal: técnico de sistemas (SMR) y desarrollador backend (DAW) con foco en IA.' } = Astro.props;
---
<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%238b5cf6'/><text x='16' y='22' font-size='15' font-family='monospace' font-weight='700' text-anchor='middle' fill='white'>RB</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-bg text-ink font-sans antialiased selection:bg-violet-500/30">
    <slot />
  </body>
</html>
