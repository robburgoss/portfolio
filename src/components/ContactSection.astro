---
import { profile } from '../data/profileData';
import Section from './Section.astro';
---
<Section id="contact" title="Contacto">
  <p class="text-mute">La forma más rápida de hablar conmigo es por email.</p>
  <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-3">
    <a href={`mailto:${profile.email}`} class="link wide break-all text-xl font-semibold tracking-tight sm:text-3xl">{profile.email}</a>
    <button id="copy-email" type="button" data-email={profile.email} class="btn-quiet !px-3.5 !py-1.5 text-sm">Copiar</button>
  </div>
  <p id="copy-status" class="mt-2 min-h-6 text-sm text-signal" role="status" aria-live="polite"></p>
  <p class="text-[0.95rem] text-mute">
    <a class="link" href={`tel:${profile.phone.replace(/\s/g, '')}`}>{profile.phone}</a>
    <span class="mx-2" aria-hidden="true">/</span>{profile.location}
  </p>

  <form
    id="contact-form"
    class="mt-12 max-w-xl space-y-5"
    data-email={profile.email}
    data-public-key={profile.emailjs.publicKey}
    data-service-id={profile.emailjs.serviceId}
    data-template-id={profile.emailjs.templateId}
  >
    <h3 class="font-semibold">O déjame un mensaje</h3>
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="name" class="text-sm font-medium">Nombre</label>
        <input id="name" name="name" autocomplete="name" required class="field" />
      </div>
      <div>
        <label for="email" class="text-sm font-medium">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required class="field" />
      </div>
    </div>
    <div>
      <label for="message" class="text-sm font-medium">Mensaje</label>
      <textarea id="message" name="message" rows="5" required class="field resize-y"></textarea>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <button id="submit-btn" type="submit" class="btn-primary disabled:opacity-60">Enviar mensaje</button>
      <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
    </div>
  </form>
</Section>

<script>
  const copyBtn = document.getElementById('copy-email') as HTMLButtonElement | null;
  const status = document.getElementById('copy-status');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.email ?? '');
      if (status) status.textContent = 'Email copiado.';
    } catch {
      if (status) status.textContent = 'No se ha podido copiar. Selecciona el email y cópialo a mano.';
    }
    setTimeout(() => { if (status) status.textContent = ''; }, 2500);
  });

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const formStatus = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  function show(msg: string, ok: boolean) {
    if (!formStatus) return;
    formStatus.textContent = msg;
    formStatus.className = `text-sm ${ok ? 'text-signal' : 'text-red-700 dark:text-red-400'}`;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const { publicKey, serviceId, templateId } = form.dataset;

    // Si EmailJS no está configurado, respaldo con mailto.
    if (!publicKey || !serviceId || !templateId) {
      const subject = encodeURIComponent(`Contacto desde portfolio: ${d.get('name')}`);
      const body = encodeURIComponent(`${d.get('message')}\n\n— ${d.get('name')} (${d.get('email')})`);
      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
      return;
    }

    // Anti-spam: si el campo oculto está marcado, no se envía.
    if (d.get('botcheck')) return;

    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Enviando…'; }
    try {
      const emailjs = (await import('@emailjs/browser')).default;
      emailjs.init({ publicKey });
      await emailjs.send(serviceId, templateId, {
        name: d.get('name') as string,
        email: d.get('email') as string,
        message: d.get('message') as string,
        to_email: form.dataset.email as string,
      });
      show('Mensaje enviado. Te contestaré por email.', true);
      form.reset();
    } catch (error) {
      console.error('Error al enviar con EmailJS:', error);
      show(`No se ha podido enviar. Escríbeme directamente a ${form.dataset.email}.`, false);
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Enviar mensaje'; }
    }
  });
</script>
