---
import { profile } from '../data/profileData';
---
<footer class="wrap">
  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line py-10 text-[0.95rem] text-mute">
    <p>© 2026 {profile.name}</p>
    <div class="flex gap-6">
      <a class="link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="link" href="#top">Volver arriba</a>
    </div>
  </div>
</footer>
