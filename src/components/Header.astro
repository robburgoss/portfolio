---
import { profile } from '../data/profileData';
const links = [
  ['#about', 'about'], ['#skills', 'skills'], ['#projects', 'projects'], ['#experience', 'experience'], ['#contact', 'contact'],
];
---
<div class="border-b border-line bg-zinc-950 font-mono text-xs text-zinc-400">
  <div class="mx-auto flex max-w-5xl items-center gap-2 px-5 py-2 sm:px-8">
    <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400"></span>
    <p class="truncate"><span class="text-violet-400">$</span> status: <span class="text-blue-400">seeking backend / devops junior roles</span><span class="cursor ml-0.5 text-violet-400">▌</span></p>
  </div>
</div>
<header class="sticky top-0 z-50 border-b border-line bg-bg/80 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a href="#top" class="font-mono text-sm font-semibold text-ink hover:text-violet-400 transition">[RB] <span class="hidden text-zinc-500 sm:inline">{profile.handle}</span></a>
    <nav class="hidden items-center gap-6 md:flex" aria-label="Principal">
      {links.map(([href, label]) => <a href={href} class="font-mono text-xs text-mute transition hover:text-ink">{label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href={profile.cv} download class="btn-primary !px-4 !py-2 text-xs">Descargar CV</a>
      <details class="relative md:hidden">
        <summary class="cursor-pointer list-none rounded-md border border-line px-2.5 py-1.5 font-mono text-xs" aria-label="Menú">menu</summary>
        <div class="absolute right-0 mt-2 w-40 rounded-lg border border-line bg-surface p-2">
          {links.map(([href, label]) => <a href={href} class="block rounded px-3 py-2 font-mono text-xs text-mute hover:bg-zinc-800 hover:text-ink">{label}</a>)}
        </div>
      </details>
    </div>
  </div>
</header>
