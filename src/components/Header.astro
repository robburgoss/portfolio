---
import { profile } from '../data/profileData';
const links = [
  ['#projects', 'Proyectos'],
  ['#experience', 'Experiencia'],
  ['#skills', 'Conocimientos'],
  ['#contact', 'Contacto'],
];
---
<header class="sticky top-0 z-50 border-b border-line bg-paper">
  <div class="wrap flex h-14 items-center justify-between gap-4">
    <a href="#top" class="wide text-[0.95rem] font-semibold tracking-tight transition-colors hover:text-signal">{profile.name}</a>
    <nav class="hidden items-center gap-7 text-[0.95rem] md:flex" aria-label="Principal">
      {links.map(([href, label]) => <a href={href} class="text-mute transition-colors hover:text-ink">{label}</a>)}
      <a href={profile.cv} download class="link font-medium">CV</a>
    </nav>
    <details class="group relative md:hidden">
      <summary class="cursor-pointer list-none rounded-[2px] border border-line bg-panel px-3 py-1.5 text-sm [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Menú</span><span class="hidden group-open:inline">Cerrar</span>
      </summary>
      <nav class="absolute right-0 mt-2 w-48 rounded-[2px] border border-line bg-panel py-2 shadow-lg shadow-black/10 dark:shadow-black/40" aria-label="Principal">
        {links.map(([href, label]) => <a href={href} class="block px-4 py-2 text-[0.95rem] hover:bg-paper hover:text-signal">{label}</a>)}
        <a href={profile.cv} download class="block border-t border-line px-4 pb-1 pt-3 text-[0.95rem] font-medium hover:bg-paper hover:text-signal">Descargar CV</a>
      </nav>
    </details>
  </div>
</header>
