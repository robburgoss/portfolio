---
interface Props {
  title: string; description: string; tags: string[];
  type: 'real' | 'placeholder';
  status: 'Publicado' | 'En Desarrollo' | 'Planificado';
  githubUrl?: string; demoUrl?: string;
}
const { title, description, tags, type, status, githubUrl, demoUrl } = Astro.props;
const real = type === 'real';
const statusColor = status === 'Publicado' ? 'text-emerald-400 border-emerald-500/30' : status === 'En Desarrollo' ? 'text-blue-400 border-blue-500/30' : 'text-zinc-400 border-zinc-600/50';
---
<article data-kind={type} class={`card flex h-full flex-col p-6 ${real ? 'card-hover' : 'border-dashed hover:border-blue-500/60 hover:shadow-glowBlue'}`}>
  <div class="mb-4 flex items-center justify-between gap-2">
    <span class={`font-mono text-xs ${real ? 'text-violet-400' : 'text-blue-400'}`}>{real ? 'proyecto_real' : 'investigación'}</span>
    <span class={`rounded-md border px-2 py-0.5 font-mono text-xs ${statusColor}`}>{status}</span>
  </div>
  <h3 class="text-lg font-semibold">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-mute">{description}</p>
  <ul class="mt-4 flex flex-wrap gap-2">{tags.map((t) => <li class="badge">{t}</li>)}</ul>
  {(githubUrl || demoUrl) && (
    <div class="mt-5 flex gap-4 font-mono text-xs">
      {githubUrl && <a class="text-mute transition hover:text-violet-400" href={githubUrl} target="_blank" rel="noopener noreferrer">código</a>}
      {demoUrl && <a class="text-mute transition hover:text-blue-400" href={demoUrl} target="_blank" rel="noopener noreferrer">demo</a>}
    </div>
  )}
</article>
