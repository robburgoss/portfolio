---
import { timeline } from '../data/profileData';
import Section from './Section.astro';
---
<Section id="experience" title="Experiencia y formación">
  <ol class="space-y-8">
    {timeline.map((i) => (
      <li class="grid gap-1 sm:grid-cols-[8.5rem_1fr] sm:gap-6">
        <p class="tnum pt-0.5 text-[0.95rem] text-mute">{i.period}</p>
        <div>
          <h3 class="font-semibold leading-snug">{i.title}</h3>
          <p class="text-[0.95rem] text-mute">{i.org}</p>
          {i.text && <p class="mt-2 max-w-[62ch] text-[0.95rem]">{i.text}</p>}
        </div>
      </li>
    ))}
  </ol>
</Section>
